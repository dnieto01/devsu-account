# Copia a .env y ajusta (docker compose carga .env automáticamente):
#   cp .env.example .env

# --- Perfil Spring activo en el contenedor API ---
# prod  = Redis lock + JDBC Postgres (stack Docker)
# local = lock en memoria; en este compose sigue usando Postgres/Redis/Kafka/Mongo del .yml
# test  = útil para pruebas; mismo stack
SPRING_PROFILES_ACTIVE=prod

# Puerto HTTP publicado del API
SERVER_PORT=8096

# Postgres
POSTGRES_DB=devsu
POSTGRES_USER=devsu
POSTGRES_PASSWORD=devsu
POSTGRES_PORT=5432

# JPA (en el primer arranque suele usarse update; en producción real usar validate + migraciones)
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# Mongo
MONGO_DATABASE=devsu_account
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=example
MONGO_PORT_PUBLISH=27017

# Redis / Kafka (puertos solo si quieres conectarte desde el host)
REDIS_PORT_PUBLISH=6379
KAFKA_PORT_PUBLISH=9094

# Nombre de imagen local tras el build
API_IMAGE_NAME=devsu-account:local

# --- Si este compose corre EN PARALELO con devsu-user (otro compose en el mismo host) ---
# Asigna puertos host distintos en UNO de los dos .env, p. ej. en user: POSTGRES_PORT=5433
# y REDIS_PORT_PUBLISH=6380. Para ambas APIs compartiendo una sola infra: ../devsu-compose
